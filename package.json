{
  "name": "greedy-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented multi-game backend foundation with Greedy as the first game.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/server.ts src/worker.ts --format esm --platform node --target node22 --out-dir dist --sourcemap --clean",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:harden": "prisma db execute --file prisma/hardening.sql",
    "admin:bootstrap": "tsx src/cli/admin.ts bootstrap",
    "admin:recover": "tsx src/cli/admin.ts recover",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@socket.io/redis-streams-adapter": "0.3.0",
    "argon2": "^0.45.1",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "heic-convert": "^2.1.0",
    "helmet": "8.1.0",
    "http-status": "2.1.0",
    "multer": "^2.2.0",
    "pg": "8.16.3",
    "redis": "5.8.2",
    "sharp": "^0.35.3",
    "socket.io": "4.8.1",
    "winston": "3.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "prisma": "^7.9.1",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
