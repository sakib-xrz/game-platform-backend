    {
      "name": "01 \u2014 Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Stores Bearer session token for all admin requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"login ok\", () => pm.expect(json.success).to.eql(true));",
                  "const token = json.data && json.data.session_token;",
                  "pm.expect(token).to.be.ok;",
                  "pm.collectionVariables.set(\"admin_session_token\", token);",
                  "pm.environment.set(\"admin_session_token\", token);"
                ]
              }
            }
          ]
        }
      ]
    },
