    {
      "name": "03 \u2014 Player / Snapshot",
      "item": [
        {
          "name": "Snapshot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "X-User-Id",
                "value": "{{user_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games/lucky-77/snapshot",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "lucky-77",
                "snapshot"
              ]
            },
            "description": "Captures round/option IDs, slot_map, and wallet balance."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.success).to.eql(true);",
                  "const data = json.data;",
                  "pm.test(\"slot_map has 9 slots\", () => pm.expect(data.slot_map).to.have.length(9));",
                  "pm.test(\"3 options\", () => pm.expect(data.active_config.options).to.have.length(3));",
                  "pm.collectionVariables.set(\"slot_map\", JSON.stringify(data.slot_map || []));",
                  "const round = data.round;",
                  "if (round) {",
                  "  pm.collectionVariables.set(\"current_round_id\", round.id);",
                  "  pm.collectionVariables.set(\"current_round_status\", round.status || \"\");",
                  "  const option = (round.options || data.active_config.options || []).find(o => o.code === (pm.environment.get(\"bet_option_code\") || \"APPLE\"))",
                  "    || (round.options || data.active_config.options || []).find(o => o.is_enabled !== false);",
                  "  if (option) {",
                  "    pm.collectionVariables.set(\"current_option_id\", option.id);",
                  "    pm.collectionVariables.set(\"current_option_code\", option.code || \"\");",
                  "    pm.collectionVariables.set(\"current_option_payout_multiplier\", option.payout_multiplier || \"\");",
                  "  }",
                  "  if (round.result) {",
                  "    pm.collectionVariables.set(\"winning_slot_index\", String(round.result.winning_slot_index ?? \"\"));",
                  "    pm.collectionVariables.set(\"winning_option_code\", round.result.winning_option?.code || \"\");",
                  "  }",
                  "}",
                  "if (data.wallet) {",
                  "  pm.collectionVariables.set(\"wallet_balance\", String(data.wallet.balance ?? \"\"));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
