                "bets"
              ]
            },
            "description": "Requires Snapshot first while status is betting_open. Expects 201 Created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"round_id\": \"{{current_round_id}}\",\n  \"option_id\": \"{{current_option_id}}\",\n  \"amount\": \"{{bet_amount}}\",\n  \"client_request_id\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json.success).to.eql(true);",
                  "const data = json.data;",
                  "pm.collectionVariables.set(\"bet_id\", data.bet_id);",
                  "pm.collectionVariables.set(\"last_client_request_id\", data.client_request_id);",
                  "pm.collectionVariables.set(\"wallet_balance\", String(data.wallet_balance ?? \"\"));",
                  "pm.collectionVariables.set(\"last_bet_round_id\", data.round_id);",
                  "pm.collectionVariables.set(\"last_bet_option_id\", data.option_id);",
                  "pm.collectionVariables.set(\"last_bet_amount\", String(data.amount ?? \"\"));"
                ]
              }
            }
          ]
