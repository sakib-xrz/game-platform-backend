generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  active
  paused
  maintenance
  disabled

  @@map("game_status")
}

enum GreedyRuntimeStatus {
  stopped
  running
  paused
  degraded

  @@map("greedy_runtime_status")
}

enum ConfigVersionStatus {
  draft
  review_pending
  published
  retired

  @@map("config_version_status")
}

enum GreedyRoundStatus {
  created
  betting_open
  betting_locked
  result_ready
  drawing
  result_revealed
  settling
  settled
  closed
  cancelled

  @@map("greedy_round_status")
}

enum TeenPattiRuntimeStatus {
  stopped
  running
  paused
  degraded

  @@map("teen_patti_runtime_status")
}

enum TeenPattiRoundStatus {
  created
  betting_open
  betting_locked
  result_ready
  drawing
  result_revealed
  settling
  settled
  closed
  cancelled

  @@map("teen_patti_round_status")
}


enum Lucky77RuntimeStatus {
  stopped
  running
  paused
  degraded

  @@map("lucky_77_runtime_status")
}

enum Lucky77RoundStatus {
  created
  betting_open
  betting_locked
  result_ready
  drawing
  result_revealed
  settling
  settled
  closed
  cancelled

  @@map("lucky_77_round_status")
}

enum GreedyClassicRuntimeStatus {
  stopped
  running
  paused
  degraded

  @@map("greedy_classic_runtime_status")
}

enum GreedyClassicRoundStatus {
  created
  betting_open
  betting_locked
  result_ready
  drawing
  result_revealed
  settling
  settled
  closed
  cancelled

  @@map("greedy_classic_round_status")
}


enum WalletLedgerType {
  bet_debit
  win_credit
  bet_refund
  admin_credit
  admin_debit
  bonus_credit
  purchase_credit
  withdrawal_debit
  reversal_credit
  reversal_debit

  @@map("wallet_ledger_type")
}

enum SettlementOutcome {
  win
  loss
  refunded

  @@map("settlement_outcome")
}

enum IdempotencyStatus {
  processing
  completed
  failed

  @@map("idempotency_status")
}

enum OutboxStatus {
  pending
  processing
  published
  failed

  @@map("outbox_status")
}

enum AuditActorType {
  system
  admin
  user

  @@map("audit_actor_type")
}

enum AdminRole {
  dev_super_admin
  super_admin
  game_operator
  finance_operator
  support
  auditor

  @@map("admin_role")
}

enum AdminStatus {
  active
  locked
  disabled

  @@map("admin_status")
}

enum PlatformAppStatus {
  active
  disabled

  @@map("platform_app_status")
}

enum PlatformUserStatus {
  active
  disabled

  @@map("platform_user_status")
}

enum AdminApprovalStatus {
  pending
  approved
  rejected
  expired
  applied
  failed

  @@map("admin_approval_status")
}

enum AdminApprovalDecisionType {
  approve
  reject

  @@map("admin_approval_decision")
}

enum AdminAssetStatus {
  pending
  ready
  rejected
  deleted

  @@map("admin_asset_status")
}

enum OpsAlertSeverity {
  info
  warning
  critical

  @@map("ops_alert_severity")
}

enum OpsAlertStatus {
  open
  acknowledged
  resolved

  @@map("ops_alert_status")
}

model Currency {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  symbol     String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  wallets Wallet[]

  @@map("currencies")
}

model Wallet {
  id          String   @id @default(cuid())
  user_id     String
  currency_id String
  balance     BigInt   @default(0)
  version     Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  currency Currency       @relation(fields: [currency_id], references: [id], onDelete: Restrict)
  ledger   WalletLedger[]
  bets     GreedyBet[]
  payouts  GreedyUserPayout[]
  refunds  GreedyUserRefund[]
  teen_patti_bets    TeenPattiBet[]
  teen_patti_payouts TeenPattiUserPayout[]
  teen_patti_refunds TeenPattiUserRefund[]
  lucky_77_bets    Lucky77Bet[]
  lucky_77_payouts Lucky77UserPayout[]
  lucky_77_refunds Lucky77UserRefund[]
  greedy_classic_bets    GreedyClassicBet[]
  greedy_classic_payouts GreedyClassicUserPayout[]
  greedy_classic_refunds GreedyClassicUserRefund[]

  @@unique([user_id, currency_id])
  @@index([user_id])
  @@map("wallets")
}

model WalletLedger {
  id               String           @id @default(cuid())
  wallet_id        String
  user_id          String
  game_id          String?
  type             WalletLedgerType
  amount           BigInt
  balance_before   BigInt
  balance_after    BigInt
  reference_type   String?
  reference_id     String?
  idempotency_key  String?
  metadata         Json?
  created_at       DateTime         @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  game   Game?  @relation(fields: [game_id], references: [id], onDelete: Restrict)

  debit_bet GreedyBet?        @relation("bet_debit_ledger")
  payout    GreedyUserPayout? @relation("payout_ledger")
  refund    GreedyUserRefund? @relation("refund_ledger")
  teen_patti_debit_bet TeenPattiBet?        @relation("teen_patti_bet_debit_ledger")
  teen_patti_payout    TeenPattiUserPayout? @relation("teen_patti_payout_ledger")
  teen_patti_refund    TeenPattiUserRefund? @relation("teen_patti_refund_ledger")
  lucky_77_debit_bet Lucky77Bet?        @relation("lucky_77_bet_debit_ledger")
  lucky_77_payout    Lucky77UserPayout? @relation("lucky_77_payout_ledger")
  lucky_77_refund    Lucky77UserRefund? @relation("lucky_77_refund_ledger")
  greedy_classic_debit_bet GreedyClassicBet?        @relation("greedy_classic_bet_debit_ledger")
  greedy_classic_payout    GreedyClassicUserPayout? @relation("greedy_classic_payout_ledger")
  greedy_classic_refund    GreedyClassicUserRefund? @relation("greedy_classic_refund_ledger")
  platform_coin_deposits   PlatformCoinDeposit[]
  platform_coin_withdrawals PlatformCoinWithdrawal[]

  @@index([wallet_id, created_at])
  @@index([user_id, created_at])
  @@index([game_id, created_at])
  @@index([reference_type, reference_id])
  @@map("wallet_ledger")
}

model Game {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  status     GameStatus @default(active)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  wallet_ledger          WalletLedger[]
  greedy_runtime_state   GreedyRuntimeState?
  greedy_config_versions GreedyConfigVersion[]
  greedy_rounds          GreedyRound[]
  greedy_bets            GreedyBet[]
  teen_patti_runtime_state   TeenPattiRuntimeState?
  teen_patti_config_versions TeenPattiConfigVersion[]
  teen_patti_rounds          TeenPattiRound[]
  teen_patti_bets            TeenPattiBet[]
  lucky_77_runtime_state   Lucky77RuntimeState?
  lucky_77_config_versions Lucky77ConfigVersion[]
  lucky_77_rounds          Lucky77Round[]
  lucky_77_bets            Lucky77Bet[]
  greedy_classic_runtime_state   GreedyClassicRuntimeState?
  greedy_classic_config_versions GreedyClassicConfigVersion[]
  greedy_classic_rounds          GreedyClassicRound[]
  greedy_classic_bets            GreedyClassicBet[]

  @@map("games")
}

model GreedyRuntimeState {
  id                       String              @id @default(cuid())
  game_id                  String              @unique
  current_round_id         String?             @unique
  active_config_version_id String?
  status                   GreedyRuntimeStatus @default(stopped)
  last_round_number        BigInt              @default(0)
  revision                 BigInt              @default(0)
  updated_at               DateTime            @updatedAt
  created_at               DateTime            @default(now())

  game                  Game                 @relation(fields: [game_id], references: [id], onDelete: Restrict)
  current_round         GreedyRound?         @relation("runtime_current_round", fields: [current_round_id], references: [id], onDelete: SetNull)
  active_config_version GreedyConfigVersion? @relation("runtime_active_config", fields: [active_config_version_id], references: [id], onDelete: Restrict)

  @@map("greedy_runtime_state")
}

model GreedyConfigVersion {
  id                     String              @id @default(cuid())
  game_id                String
  version                Int
  status                 ConfigVersionStatus @default(draft)
  betting_duration_ms    Int
  lock_duration_ms       Int
  drawing_duration_ms    Int
  result_duration_ms     Int
  min_bet                BigInt
  max_single_bet         BigInt
  max_round_bet          BigInt
  created_by             String?
  notes                  String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  published_at           DateTime?
  retired_at             DateTime?

  game                   Game                 @relation(fields: [game_id], references: [id], onDelete: Restrict)
  options                GreedyOptionVersion[]
  chip_values            GreedyChipValueVersion[]
  rounds                 GreedyRound[]
  results                GreedyRoundResult[]
  active_runtime_states  GreedyRuntimeState[] @relation("runtime_active_config")

  @@unique([game_id, version])
  @@index([game_id, status])
  @@map("greedy_config_versions")
}


model GreedyChipValueVersion {
  id                String   @id @default(cuid())
  config_version_id String
  amount            BigInt
  display_order     Int
  is_enabled        Boolean  @default(true)
  created_at        DateTime @default(now())

  config_version GreedyConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)

  @@unique([config_version_id, amount])
  @@unique([config_version_id, display_order])
  @@index([config_version_id, is_enabled])
  @@map("greedy_chip_value_versions")
}

model GreedyOptionVersion {
  id                    String   @id @default(cuid())
  config_version_id     String
  code                  String
  name                  String
  image_url             String?
  asset_id              String?
  display_order         Int
  payout_numerator      BigInt
  payout_denominator    BigInt   @default(1)
  probability_weight    BigInt
  is_enabled            Boolean  @default(true)
  created_at            DateTime @default(now())

  config_version GreedyConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  asset          AdminAsset?          @relation(fields: [asset_id], references: [id], onDelete: Restrict)
  bets           GreedyBet[]
  winning_results GreedyRoundResult[] @relation("winning_option")

  @@unique([config_version_id, code])
  @@unique([config_version_id, display_order])
  @@index([config_version_id, is_enabled])
  @@map("greedy_option_versions")
}

model GreedyRound {
  id                    String            @id @default(cuid())
  game_id               String
  round_number          BigInt
  config_version_id     String
  status                GreedyRoundStatus @default(created)
  betting_started_at    DateTime?
  betting_ends_at       DateTime?
  locked_at             DateTime?
  result_generated_at   DateTime?
  drawing_started_at    DateTime?
  result_reveal_at      DateTime?
  settlement_started_at DateTime?
  settled_at            DateTime?
  closed_at             DateTime?
  cancelled_at          DateTime?
  cancellation_reason   String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  game           Game                @relation(fields: [game_id], references: [id], onDelete: Restrict)
  config_version GreedyConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  result         GreedyRoundResult?
  bets           GreedyBet[]
  settlements    GreedyBetSettlement[]
  payouts        GreedyUserPayout[]
  refunds        GreedyUserRefund[]
  runtime_current GreedyRuntimeState? @relation("runtime_current_round")

  @@unique([game_id, round_number])
  @@index([game_id, status])
  @@index([status, betting_ends_at])
  @@index([created_at])
  @@map("greedy_rounds")
}

model GreedyRoundResult {
  id                        String   @id @default(cuid())
  round_id                  String   @unique
  winning_option_version_id String
  algorithm_version         String
  config_version_id         String
  entropy_digest            String
  audit_hash                String
  generated_at              DateTime @default(now())
  revealed_at               DateTime?

  round          GreedyRound         @relation(fields: [round_id], references: [id], onDelete: Restrict)
  winning_option GreedyOptionVersion @relation("winning_option", fields: [winning_option_version_id], references: [id], onDelete: Restrict)
  config_version GreedyConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  settlements    GreedyBetSettlement[]

  @@index([generated_at])
  @@map("greedy_round_results")
}

model GreedyBet {
  id                      String   @id @default(cuid())
  game_id                 String
  round_id                String
  user_id                 String
  wallet_id               String?
  option_version_id       String
  amount                  BigInt
  payout_numerator        BigInt
  payout_denominator      BigInt
  client_request_id       String
  wallet_debit_ledger_id  String?  @unique
  accepted_at             DateTime @default(now())
  created_at              DateTime @default(now())

  game          Game                @relation(fields: [game_id], references: [id], onDelete: Restrict)
  round         GreedyRound         @relation(fields: [round_id], references: [id], onDelete: Restrict)
  wallet        Wallet?             @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  option        GreedyOptionVersion @relation(fields: [option_version_id], references: [id], onDelete: Restrict)
  debit_ledger  WalletLedger?       @relation("bet_debit_ledger", fields: [wallet_debit_ledger_id], references: [id], onDelete: Restrict)
  settlement    GreedyBetSettlement?

  @@unique([user_id, client_request_id])
  @@index([round_id, user_id])
  @@index([round_id, option_version_id])
  @@index([user_id, created_at])
  @@map("greedy_bets")
}

model GreedyBetSettlement {
  id            String            @id @default(cuid())
  round_id      String
  bet_id        String            @unique
  result_id     String?
  outcome       SettlementOutcome
  payout_amount BigInt            @default(0)
  settled_at    DateTime          @default(now())

  round  GreedyRound       @relation(fields: [round_id], references: [id], onDelete: Restrict)
  bet    GreedyBet         @relation(fields: [bet_id], references: [id], onDelete: Restrict)
  result GreedyRoundResult? @relation(fields: [result_id], references: [id], onDelete: Restrict)

  @@index([round_id, outcome])
  @@map("greedy_bet_settlements")
}

model GreedyUserPayout {
  id                    String   @id @default(cuid())
  round_id              String
  user_id               String
  wallet_id             String
  winning_bet_count     Int
  total_winning_stake   BigInt
  total_payout          BigInt
  wallet_ledger_id      String   @unique
  created_at            DateTime @default(now())

  round        GreedyRound  @relation(fields: [round_id], references: [id], onDelete: Restrict)
  wallet       Wallet       @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  wallet_ledger WalletLedger @relation("payout_ledger", fields: [wallet_ledger_id], references: [id], onDelete: Restrict)

  @@unique([round_id, user_id])
  @@index([user_id, created_at])
  @@map("greedy_user_payouts")
}

model GreedyUserRefund {
  id               String   @id @default(cuid())
  round_id         String
  user_id          String
  wallet_id        String
  total_bet_amount BigInt
  wallet_ledger_id String   @unique
  created_at       DateTime @default(now())

  round         GreedyRound  @relation(fields: [round_id], references: [id], onDelete: Restrict)
  wallet        Wallet       @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  wallet_ledger WalletLedger @relation("refund_ledger", fields: [wallet_ledger_id], references: [id], onDelete: Restrict)

  @@unique([round_id, user_id])
  @@index([user_id, created_at])
  @@map("greedy_user_refunds")
}

model TeenPattiRuntimeState {
  id                       String                @id @default(cuid())
  game_id                  String                @unique
  current_round_id         String?               @unique
  active_config_version_id String?
  status                   TeenPattiRuntimeStatus @default(stopped)
  last_round_number        BigInt                @default(0)
  revision                 BigInt                @default(0)
  updated_at               DateTime              @updatedAt
  created_at               DateTime              @default(now())

  game                  Game                   @relation(fields: [game_id], references: [id], onDelete: Restrict)
  current_round         TeenPattiRound?        @relation("teen_patti_runtime_current_round", fields: [current_round_id], references: [id], onDelete: SetNull)
  active_config_version TeenPattiConfigVersion? @relation("teen_patti_runtime_active_config", fields: [active_config_version_id], references: [id], onDelete: Restrict)

  @@map("teen_patti_runtime_state")
}

model TeenPattiConfigVersion {
  id                     String              @id @default(cuid())
  game_id                String
  version                Int
  status                 ConfigVersionStatus @default(draft)
  betting_duration_ms    Int
  lock_duration_ms       Int
  drawing_duration_ms    Int
  result_duration_ms     Int
  min_bet                BigInt
  max_single_bet         BigInt
  max_round_bet          BigInt
  rake_bps               Int
  created_by             String?
  notes                  String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  published_at           DateTime?
  retired_at             DateTime?

  game                  Game                      @relation(fields: [game_id], references: [id], onDelete: Restrict)
  options               TeenPattiOptionVersion[]
  chip_values           TeenPattiChipValueVersion[]
  rounds                TeenPattiRound[]
  results               TeenPattiRoundResult[]
  active_runtime_states TeenPattiRuntimeState[]   @relation("teen_patti_runtime_active_config")

  @@unique([game_id, version])
  @@index([game_id, status])
  @@map("teen_patti_config_versions")
}

model TeenPattiChipValueVersion {
  id                String   @id @default(cuid())
  config_version_id String
  amount            BigInt
  display_order     Int
  is_enabled        Boolean  @default(true)
  created_at        DateTime @default(now())

  config_version TeenPattiConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)

  @@unique([config_version_id, amount])
  @@unique([config_version_id, display_order])
  @@index([config_version_id, is_enabled])
  @@map("teen_patti_chip_value_versions")
}

model TeenPattiOptionVersion {
  id            String   @id @default(cuid())
  config_version_id String
  code          String
  name          String
  image_url     String?
  asset_id      String?
  display_order Int
  is_enabled    Boolean  @default(true)
  created_at    DateTime @default(now())

  config_version  TeenPattiConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  asset           AdminAsset?            @relation(fields: [asset_id], references: [id], onDelete: Restrict)
  bets            TeenPattiBet[]
  winning_results TeenPattiRoundResult[] @relation("teen_patti_winning_option")

  @@unique([config_version_id, code])
  @@unique([config_version_id, display_order])
  @@index([config_version_id, is_enabled])
  @@map("teen_patti_option_versions")
}

model TeenPattiRound {
  id                    String              @id @default(cuid())
  game_id               String
  round_number          BigInt
  config_version_id     String
  status                TeenPattiRoundStatus @default(created)
  betting_started_at    DateTime?
  betting_ends_at       DateTime?
  locked_at             DateTime?
  result_generated_at   DateTime?
  drawing_started_at    DateTime?
  result_reveal_at      DateTime?
  settlement_started_at DateTime?
  settled_at            DateTime?
  closed_at             DateTime?
  cancelled_at          DateTime?
  cancellation_reason   String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  game            Game                    @relation(fields: [game_id], references: [id], onDelete: Restrict)
  config_version  TeenPattiConfigVersion  @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  result          TeenPattiRoundResult?
  bets            TeenPattiBet[]
  settlements     TeenPattiBetSettlement[]
  payouts         TeenPattiUserPayout[]
  refunds         TeenPattiUserRefund[]
  runtime_current TeenPattiRuntimeState?  @relation("teen_patti_runtime_current_round")

  @@unique([game_id, round_number])
  @@index([game_id, status])
  @@index([status, betting_ends_at])
  @@index([created_at])
  @@map("teen_patti_rounds")
}

model TeenPattiRoundResult {
  id                        String   @id @default(cuid())
  round_id                  String   @unique
  winning_option_version_id String
  algorithm_version         String
  config_version_id         String
  entropy_digest            String
  audit_hash                String
  deal_attempt_count        Int
  hands                     Json
  generated_at              DateTime @default(now())
  revealed_at               DateTime?

  round          TeenPattiRound         @relation(fields: [round_id], references: [id], onDelete: Restrict)
  winning_option TeenPattiOptionVersion @relation("teen_patti_winning_option", fields: [winning_option_version_id], references: [id], onDelete: Restrict)
  config_version TeenPattiConfigVersion @relation(fields: [config_version_id], references: [id], onDelete: Restrict)
  settlements    TeenPattiBetSettlement[]

  @@index([generated_at])
  @@map("teen_patti_round_results")
}

model TeenPattiBet {
  id                     String   @id @default(cuid())
  game_id                String
  round_id               String
  user_id                String
  wallet_id              String?
  option_version_id      String
  amount                 BigInt
  client_request_id      String
  wallet_debit_ledger_id String?  @unique
  accepted_at            DateTime @default(now())
  created_at             DateTime @default(now())

  game         Game                   @relation(fields: [game_id], references: [id], onDelete: Restrict)
  round        TeenPattiRound         @relation(fields: [round_id], references: [id], onDelete: Restrict)
  wallet       Wallet?                @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  option       TeenPattiOptionVersion @relation(fields: [option_version_id], references: [id], onDelete: Restrict)
  debit_ledger WalletLedger?          @relation("teen_patti_bet_debit_ledger", fields: [wallet_debit_ledger_id], references: [id], onDelete: Restrict)
  settlement   TeenPattiBetSettlement?

  @@unique([user_id, client_request_id])
  @@index([round_id, user_id])
  @@index([round_id, option_version_id])
  @@index([user_id, created_at])
  @@map("teen_patti_bets")
}

model TeenPattiBetSettlement {
  id            String            @id @default(cuid())
  round_id      String
  bet_id        String            @unique
  result_id     String?
  outcome       SettlementOutcome
  payout_amount BigInt            @default(0)
  settled_at    DateTime          @default(now())

  round  TeenPattiRound       @relation(fields: [round_id], references: [id], onDelete: Restrict)
  bet    TeenPattiBet         @relation(fields: [bet_id], references: [id], onDelete: Restrict)
  result TeenPattiRoundResult? @relation(fields: [result_id], references: [id], onDelete: Restrict)

  @@index([round_id, outcome])
  @@map("teen_patti_bet_settlements")
}

model TeenPattiUserPayout {
  id                  String   @id @default(cuid())
  round_id            String
  user_id             String
  wallet_id           String
  winning_bet_count   Int
  total_winning_stake BigInt
  total_payout        BigInt
  wallet_ledger_id    String   @unique
  created_at          DateTime @default(now())

  round         TeenPattiRound @relation(fields: [round_id], references: [id], onDelete: Restrict)
  wallet        Wallet         @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  wallet_ledger WalletLedger   @relation("teen_patti_payout_ledger", fields: [wallet_ledger_id], references: [id], onDelete: Restrict)

  @@unique([round_id, user_id])
  @@index([user_id, created_at])
