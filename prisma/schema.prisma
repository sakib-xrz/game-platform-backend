  updated_at                     DateTime @updatedAt

  updated_by AdminUser? @relation(fields: [updated_by_admin_id], references: [id], onDelete: SetNull)

  @@map("admin_policies")
}

model AdminAsset {
  id                  String           @id @default(cuid())
  object_key          String           @unique
  bucket              String
  content_type        String
  byte_size           Int
  checksum_sha256     String
  status              AdminAssetStatus @default(pending)
  cdn_url             String?
  uploaded_by_admin_id String
  completed_at        DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  uploaded_by AdminUser             @relation(fields: [uploaded_by_admin_id], references: [id], onDelete: Restrict)
  options    GreedyOptionVersion[]
  teen_patti_options TeenPattiOptionVersion[]
  lucky_77_options Lucky77OptionVersion[]
  greedy_classic_options GreedyClassicOptionVersion[]

  @@index([status, created_at])
  @@map("admin_assets")
}

model AdminIdempotencyRecord {
  id              String            @id @default(cuid())
  admin_user_id   String
  scope           String
  idempotency_key String
  request_hash    String
  status          IdempotencyStatus @default(processing)
  http_status     Int?
  response_body   Json?
  expires_at      DateTime
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  admin_user AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)

  @@unique([admin_user_id, scope, idempotency_key])
  @@index([expires_at])
  @@map("admin_idempotency_records")
}

model OpsAlert {
  id                    String          @id @default(cuid())
  code                  String
  severity              OpsAlertSeverity
  status                OpsAlertStatus  @default(open)
  message               String
  source                String
  dedupe_key            String?         @unique
  metadata              Json?
  first_seen_at         DateTime        @default(now())
  last_seen_at          DateTime        @default(now())
  acknowledged_at       DateTime?
  acknowledged_by_id    String?
  resolved_at           DateTime?
  resolved_by_id        String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  acknowledged_by AdminUser? @relation("alert_acknowledger", fields: [acknowledged_by_id], references: [id], onDelete: SetNull)
  resolved_by     AdminUser? @relation("alert_resolver", fields: [resolved_by_id], references: [id], onDelete: SetNull)

  @@index([status, severity, last_seen_at])
  @@index([code, source, last_seen_at])
  @@map("ops_alerts")
}

model PlatformApp {
  id                       String            @id @default(cuid())
  app_name                 String
  package_name             String            @unique
  sha_key                  String
  signing_secret           String
  signing_secret_previous  String?
  status                   PlatformAppStatus @default(active)
  created_by_admin_id      String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  created_by AdminUser? @relation("created_platform_apps", fields: [created_by_admin_id], references: [id], onDelete: SetNull)
  assigned_admins AdminUser[] @relation("admin_assigned_app")
  platform_users PlatformUser[]
  platform_coin_deposits PlatformCoinDeposit[]
  platform_coin_withdrawals PlatformCoinWithdrawal[]

  @@index([status, updated_at])
  @@map("platform_apps")
}

model PlatformUser {
  id               String             @id @default(cuid())
  platform_app_id  String
  external_user_id String
  email            String
  display_name     String
  photo_url        String?
  status           PlatformUserStatus @default(active)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  platform_app PlatformApp           @relation(fields: [platform_app_id], references: [id], onDelete: Restrict)
  coin_deposits PlatformCoinDeposit[]
  coin_withdrawals PlatformCoinWithdrawal[]

  @@unique([platform_app_id, external_user_id])
  @@index([platform_app_id, email])
  @@map("platform_users")
}

model PlatformCoinDeposit {
  id                 String   @id @default(cuid())
  platform_app_id    String
  platform_user_id   String
  external_user_id   String
  client_request_id  String
  received_amount    BigInt
  converted_amount   BigInt
  wallet_ledger_id   String   @unique
  created_at         DateTime @default(now())

  platform_app  PlatformApp  @relation(fields: [platform_app_id], references: [id], onDelete: Restrict)
  platform_user PlatformUser @relation(fields: [platform_user_id], references: [id], onDelete: Restrict)
  wallet_ledger WalletLedger @relation(fields: [wallet_ledger_id], references: [id], onDelete: Restrict)

  @@unique([platform_app_id, client_request_id])
  @@index([platform_user_id, created_at])
  @@map("platform_coin_deposits")
}

model PlatformCoinWithdrawal {
  id                 String   @id @default(cuid())
  platform_app_id    String
  platform_user_id   String
  external_user_id   String
  client_request_id  String
  requested_amount   BigInt
  transferred_amount BigInt
  wallet_ledger_id   String   @unique
  created_at         DateTime @default(now())

  platform_app  PlatformApp  @relation(fields: [platform_app_id], references: [id], onDelete: Restrict)
  platform_user PlatformUser @relation(fields: [platform_user_id], references: [id], onDelete: Restrict)
  wallet_ledger WalletLedger @relation(fields: [wallet_ledger_id], references: [id], onDelete: Restrict)

  @@unique([platform_app_id, client_request_id])
  @@index([platform_user_id, created_at])
  @@map("platform_coin_withdrawals")
}

enum GameBotStatus {
  active
  disabled

  @@map("game_bot_status")
}

model GameBot {
  id            String        @id @default(cuid())
  display_name  String
  avatar_url    String?
  persona_seed  Int           @default(0)
  game_code     String        @default("LEGACY")
  status        GameBotStatus @default(active)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@index([status, updated_at])
  @@index([game_code, status])
  @@map("game_bots")
}

model GameBotPolicy {
  id                         String   @id @default(cuid())
  code                       String   @unique @default("default")
  enabled                    Boolean  @default(true)
  target_human_win_rate      Float    @default(0.15)
  min_bots_per_round         Int      @default(2)
  max_bots_per_round         Int      @default(8)
  min_human_bets_before_bias Int      @default(1)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@map("game_bot_policies")
}
