NODE_ENV=development
PORT=8000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greedy_platform"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN=http://localhost:3000
# Deprecated migration-only admin key; production admin calls use bearer sessions.
ADMIN_API_KEY=replace-with-a-long-random-secret
# Used only by the one-time `npm run admin:bootstrap` command when --password is omitted.
ADMIN_BOOTSTRAP_PASSWORD=
ALLOW_DEV_IDENTITY_HEADER=true
WORKER_INSTANCE_ID=greedy-worker-local
GREEDY_WORKER_POLL_MS=200
OUTBOX_POLL_MS=150

# S3-compatible asset storage (Cloudflare R2 defaults are supported).
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Optional outbound operations webhook. Every request is HMAC-SHA256 signed.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
OPS_ALERT_WEBHOOK_TIMEOUT_MS=5000
OPS_ALERT_WEBHOOK_MAX_ATTEMPTS=4
