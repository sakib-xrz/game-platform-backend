NODE_ENV=development
PORT=8000

# PostgreSQL database URL
DATABASE_URL="postgres://postgres:postgres@localhost:5432/greedy_platform"

# Redis URL
REDIS_URL="redis://localhost:6379/0"

# CORS Origin (comma-separated). First origin is used as game frontend if GAME_FRONTEND_URL is unset.
CORS_ORIGIN=http://localhost:3000

# Game WebView frontend (used in sync launch_url). Example: https://game.maxlived.net
GAME_FRONTEND_URL=http://localhost:3000

# Admin Seed Email
ADMIN_SEED_EMAIL=superadmin@example.com
ADMIN_SEED_PASSWORD=SuperAdminPassword123

# Dev Super Admin Seed Email
DEV_ADMIN_SEED_EMAIL=devadmin@example.com
DEV_ADMIN_SEED_PASSWORD=dev123

# Allow Dev Identity Header
ALLOW_DEV_IDENTITY_HEADER=true

# Worker Instance ID
WORKER_INSTANCE_ID=greedy-api-local

# Worker Poll MS
GREEDY_WORKER_POLL_MS=200

# Outbox Poll MS
OUTBOX_POLL_MS=150

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
